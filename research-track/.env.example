# Database
DATABASE_URL="postgresql://research:research_secret@localhost:5433/research_track?schema=public"

# Redis (BullMQ)
REDIS_URL="redis://localhost:6379"

# NextAuth — set a long random secret before deploy
# Local: http://localhost:3000
# Public (Cloudflare zone ol-ui-ac.net): https://research.ol-ui-ac.net
NEXTAUTH_URL="https://research.ol-ui-ac.net"
APP_URL="https://research.ol-ui-ac.net"
NEXTAUTH_SECRET=""

# Admin account for seed (ADMIN_PASSWORD required, min 12 chars; never commit real values)
ADMIN_EMAIL="admin@alayen.edu.iq"
ADMIN_PASSWORD=""
ADMIN_NAME="مدير النظام"
# Optional local-only: ALLOW_GENERATED_ADMIN_PASSWORD=true

# Elsevier Scopus API (official)
SCOPUS_API_KEY=""
SCOPUS_INST_TOKEN=""
SCOPUS_AFFILIATION_ID="60118739"
SCOPUS_AFFILIATION_URL="https://www.scopus.com/pages/organization/60118739?origin=AffiliationNamesList"

# Meta WhatsApp Business Cloud API
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
# Multiple recipients: comma-separated international numbers
WHATSAPP_RECIPIENTS=""

# App
TZ="Asia/Baghdad"
APP_LOCALE="ar"
# Monitor every N minutes (minimum enforced: 5)
MONITOR_INTERVAL_MINUTES="5"
