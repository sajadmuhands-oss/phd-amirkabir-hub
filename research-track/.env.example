# Database — set your own local password; never reuse production secrets
POSTGRES_USER="research"
POSTGRES_PASSWORD="change-me-local-only"
POSTGRES_DB="research_track"
DATABASE_URL="postgresql://research:change-me-local-only@localhost:5433/research_track?schema=public"

# Redis (BullMQ)
REDIS_URL="redis://localhost:6379"

# NextAuth — set a long random secret before deploy
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# Admin account for seed (ADMIN_PASSWORD required, min 8 chars; never commit real values)
ADMIN_EMAIL="admin@alayen.edu.iq"
ADMIN_PASSWORD=""
ADMIN_NAME="مدير النظام"

# Elsevier Scopus API (official)
SCOPUS_API_KEY=""
SCOPUS_INST_TOKEN=""
SCOPUS_AFFILIATION_ID="60118739"
SCOPUS_AFFILIATION_URL="https://www.scopus.com/pages/organization/60118739?origin=AffiliationNamesList"

# Meta WhatsApp Business Cloud API
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
# Multiple recipients: comma-separated international numbers
WHATSAPP_RECIPIENTS=""

# App
# Dashboard read pages are public; /settings and admin APIs always require login.
TZ="Asia/Baghdad"
APP_LOCALE="ar"
# Monitor every N minutes (minimum enforced: 5)
MONITOR_INTERVAL_MINUTES="5"
